# ---- Server ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# ---- Auth ----
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=dev_super_secret_change_me
JWT_EXPIRES_IN=7d

# ---- PostgreSQL ----
DATABASE_URL=postgres://linkedin:linkedin@localhost:5433/linkedin

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Kafka ----
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=linkedin-clone
# Set to "false" to run the API without Kafka (events fall back to direct pub/sub)
KAFKA_ENABLED=true
