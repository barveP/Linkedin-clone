# GraphQL API endpoints (HTTP queries/mutations + WS subscriptions)
VITE_GRAPHQL_HTTP=http://localhost:4000/graphql
VITE_GRAPHQL_WS=ws://localhost:4000/graphql

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Leave blank in development — analytics only loads when this is set.
VITE_GA_MEASUREMENT_ID=
